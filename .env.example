# Any OpenAI-compatible chat API. Default: DeepSeek.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Admin dashboard (/admin). Full access with ADMIN_PASSWORD.
# Anyone can log in with DEMO_PASSWORD (default "demo") to look around read-only.
ADMIN_PASSWORD=
DEMO_PASSWORD=demo

# Abuse protection for a public demo
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=600
DAILY_MESSAGE_LIMIT=500

# Production with docker compose: the domain Caddy gets an HTTPS certificate for
DOMAIN=
